<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Scanbird-Symbol: cyan Neon-Handy auf weissem Blatt, silberner Vogel, vier Sterne.
         Skalierung 0.65 um den Viewport-Mittelpunkt (256,256), KEINE Translation:
         Der 512er-Viewport wird vom System auf 108dp gemappt, der sichtbare Kreis
         zeigt das Zentrum ~66dp — das Handy liegt dann bei 27-80dp, sicher im Kreis. -->
    <group
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:pivotX="256"
        android:pivotY="256">

        <!-- Display-Innenraum -->
        <path
            android:pathData="M159.3,68 h190.2 a9,9 0 0 1 9,9 v356.9 a9,9 0 0 1 -9,9 h-190.2 a9,9 0 0 1 -9,-9 v-356.9 a9,9 0 0 1 9,-9 z"
            android:fillColor="#0E0E1C"/>

        <!-- Sterne: je Glow + Kern (2x weiss, knallrot, eisblau) -->
        <path android:pathData="M167,204 h10 M172,199 v10" android:strokeColor="#CCF7FF" android:strokeWidth="7" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
        <path android:pathData="M167,204 h10 M172,199 v10" android:strokeColor="#FFFFFF" android:strokeWidth="2.5" android:strokeLineCap="round"/>
        <path android:pathData="M167,332 h10 M172,327 v10" android:strokeColor="#4CC9FF" android:strokeWidth="7" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
        <path android:pathData="M167,332 h10 M172,327 v10" android:strokeColor="#7FD8FF" android:strokeWidth="2.5" android:strokeLineCap="round"/>
        <path android:pathData="M335,196 h10 M340,191 v10" android:strokeColor="#FF0033" android:strokeWidth="7" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
        <path android:pathData="M335,196 h10 M340,191 v10" android:strokeColor="#FF0033" android:strokeWidth="2.5" android:strokeLineCap="round"/>
        <path android:pathData="M331,330 h10 M336,325 v10" android:strokeColor="#CCF7FF" android:strokeWidth="7" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
        <path android:pathData="M331,330 h10 M336,325 v10" android:strokeColor="#FFFFFF" android:strokeWidth="2.5" android:strokeLineCap="round"/>

        <!-- Rahmen-Glow -->
        <path
            android:pathData="M159.3,62.6 h190.2 a14.4,14.4 0 0 1 14.4,14.4 v357 a14.4,14.4 0 0 1 -14.4,14.4 h-190.2 a14.4,14.4 0 0 1 -14.4,-14.4 v-357 a14.4,14.4 0 0 1 14.4,-14.4 z"
            android:strokeColor="#00FFFF"
            android:strokeWidth="10.5"
            android:strokeAlpha="0.4"/>

        <!-- Boden-Glow (cyan, nach unten auslaufend) -->
        <path android:pathData="M150,451 h209 v20 h-209 z" android:fillAlpha="0.45">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="150" android:startY="451"
                    android:endX="150" android:endY="471">
                    <item android:offset="0" android:color="#FF55E6FF"/>
                    <item android:offset="1" android:color="#0055E6FF"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Displaykanten-Blenden -->
        <path android:pathData="M150.3,99.6 h203.4 v4.7 h-203.4 z" android:fillColor="#00FFFF"/>
        <path android:pathData="M150.3,406.2 h203.4 v5.1 h-203.4 z" android:fillColor="#00FFFF"/>

        <!-- Notch-Striche -->
        <path android:pathData="M166,78.8 h10.5 v9.4 h-10.5 z" android:fillColor="#00FFFF" android:fillAlpha="0.9"/>
        <path android:pathData="M178.5,78.8 h10.5 v9.4 h-10.5 z" android:fillColor="#00FFFF" android:fillAlpha="0.9"/>
        <path android:pathData="M191,78.8 h10.5 v9.4 h-10.5 z" android:fillColor="#00FFFF" android:fillAlpha="0.9"/>

        <!-- Lautsprecher-Schlitz und Kamera -->
        <path
            android:pathData="M212.8,78.6 h69.5 a3.5,3.5 0 0 1 3.5,3.5 v3 a3.5,3.5 0 0 1 -3.5,3.5 h-69.5 a3.5,3.5 0 0 1 -3.5,-3.5 v-3 a3.5,3.5 0 0 1 3.5,-3.5 z"
            android:strokeColor="#00FFFF" android:strokeWidth="3"/>
        <path
            android:pathData="M286.6,84.7 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
            android:strokeColor="#00FFFF" android:strokeWidth="3"/>

        <!-- Bodenpille -->
        <path
            android:pathData="M231.8,414.5 h37.9 a9.65,9.65 0 0 1 0,19.3 h-37.9 a9.65,9.65 0 0 1 0,-19.3 z"
            android:strokeColor="#00FFFF" android:strokeWidth="3"/>

        <!-- Rahmen-Kern -->
        <path
            android:pathData="M159.3,62.6 h190.2 a14.4,14.4 0 0 1 14.4,14.4 v357 a14.4,14.4 0 0 1 -14.4,14.4 h-190.2 a14.4,14.4 0 0 1 -14.4,-14.4 v-357 a14.4,14.4 0 0 1 14.4,-14.4 z"
            android:strokeColor="#00FFFF"
            android:strokeWidth="5.4"/>

        <!-- Seitentasten-Luecke -->
        <path android:pathData="M357.5,81.9 h8 v31.4 h-8 z" android:fillColor="#0C0C18"/>
        <path
            android:pathData="M361.3,85.5 h0.4 a2,2 0 0 1 2,2 v20 a2,2 0 0 1 -2,2 h-0.4 a2,2 0 0 1 -2,-2 v-20 a2,2 0 0 1 2,-2 z"
            android:strokeColor="#00FFFF" android:strokeWidth="1.5" android:strokeAlpha="0.9"/>

        <!-- Vogel: Koerper-Glow in hellem Silber -->
        <path
            android:pathData="M184,256 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0"
            android:strokeColor="#E8EBF7" android:strokeWidth="12" android:strokeAlpha="0.3"/>

        <!-- Vogel: Koerper-Kern in Silber-Neon -->
        <path android:pathData="M184,256 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0" android:strokeWidth="4">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="radial" android:centerX="241.6" android:centerY="234.4" android:gradientRadius="129.6">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fluegelbogen in Silber-Neon -->
        <path android:pathData="M214,272 Q246,250 280,268" android:strokeWidth="5" android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="radial" android:centerX="240.4" android:centerY="264.2" android:gradientRadius="59.4">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Schnabel in Silber-Neon -->
        <path android:pathData="M314,247 L340,256 L312,267 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="323.2" android:centerY="254" android:gradientRadius="25.2">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Auge: Silber-Neon-Augenweiss mit dunkler Pupille -->
        <path android:pathData="M277,238 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="285.8" android:centerY="234.7" android:gradientRadius="19.8">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M288,241 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#14141E"/>
    </group>
</vector>
