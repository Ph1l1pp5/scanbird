<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Scanbird-Symbol, zweite Fassung (Philipp, 10.11.): nur das Innenleben.
         Schwarzer Vollkreis (r 170.67 = sichtbare 72dp-Maske, KEIN Weiss mehr),
         vier Sterne an den Bildschirmecken, Vogel 1.458x um (256,256) vergroessert
         (Koerper r 105). Der Cyan-Handy-Rahmen ist ab hier NICHT mehr im Icon —
         er wandert als Rahmenansicht in die geoeffnete App. Keine Gruppen-Skalierung,
         KEINE Translation (Lektion aus dem weissen-Feld-Bug). -->
    <!-- Schwarzer Grund -->
    <path
        android:pathData="M85.33,256 a170.67,170.67 0 1,0 341.33,0 a170.67,170.67 0 1,0 -341.33,0"
        android:fillColor="#0E0E1C"/>

    <!-- Sterne: je Glow + Kern (2x weiss, knallrot, eisblau) -->
    <path android:pathData="M158,172 h10 M163,167 v10" android:strokeColor="#CCF7FF" android:strokeWidth="13" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
    <path android:pathData="M158,172 h10 M163,167 v10" android:strokeColor="#FFFFFF" android:strokeWidth="4.5" android:strokeLineCap="round"/>
    <path android:pathData="M158,340 h10 M163,335 v10" android:strokeColor="#4CC9FF" android:strokeWidth="13" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
    <path android:pathData="M158,340 h10 M163,335 v10" android:strokeColor="#7FD8FF" android:strokeWidth="4.5" android:strokeLineCap="round"/>
    <path android:pathData="M334,174 h10 M339,169 v10" android:strokeColor="#FF0033" android:strokeWidth="13" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
    <path android:pathData="M334,174 h10 M339,169 v10" android:strokeColor="#FF0033" android:strokeWidth="4.5" android:strokeLineCap="round"/>
    <path android:pathData="M330,336 h10 M335,331 v10" android:strokeColor="#CCF7FF" android:strokeWidth="13" android:strokeAlpha="0.4" android:strokeLineCap="round"/>
    <path android:pathData="M330,336 h10 M335,331 v10" android:strokeColor="#FFFFFF" android:strokeWidth="4.5" android:strokeLineCap="round"/>

    <!-- Vogel: 1.458x um (256,256) vergroessert -->
    <group
        android:scaleX="1.458"
        android:scaleY="1.458"
        android:pivotX="256"
        android:pivotY="256">

        <!-- Koerper-Glow in hellem Silber -->
        <path
            android:pathData="M184,256 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0"
            android:strokeColor="#E8EBF7" android:strokeWidth="18" android:strokeAlpha="0.3"/>

        <!-- Koerper-Kern in Silber-Neon -->
        <path android:pathData="M184,256 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0" android:strokeWidth="7">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="radial" android:centerX="241.6" android:centerY="234.4" android:gradientRadius="129.6">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fluegelbogen in Silber-Neon -->
        <path android:pathData="M214,272 Q246,250 280,268" android:strokeWidth="8" android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="radial" android:centerX="240.4" android:centerY="264.2" android:gradientRadius="59.4">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Schnabel in Silber-Neon -->
        <path android:pathData="M314,247 L340,256 L312,267 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="323.2" android:centerY="254" android:gradientRadius="25.2">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Auge: Silber-Neon-Augenweiss mit dunkler Pupille -->
        <path android:pathData="M277,238 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="285.8" android:centerY="234.7" android:gradientRadius="19.8">
                    <item android:offset="0" android:color="#F4F6FB"/>
                    <item android:offset="0.55" android:color="#CDD3E0"/>
                    <item android:offset="1" android:color="#9AA3B8"/>
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M288,241 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#14141E"/>
    </group>
</vector>
